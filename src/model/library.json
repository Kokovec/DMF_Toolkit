      {
        "id": "module.latency",
        "name": "Latency budget",
        "group": "module",
        "kind": "module",
        "key": "timing",
        "description": "Maximum delay through the module; the orchestrator sizes buffers within it.",
        "parameters": {
          "schema": {
            "type": "object",
            "title": "Timing",
            "properties": {
              "maxLatencyMs": {
                "type": "number",
                "title": "Latency budget (ms)",
                "description": "Maximum delay from stream arrival to published grain; the orchestrator sizes buffers within it.",
                "minimum": 0,
                "maximum": 10000,
                "default": 20
              }
            },
            "x-audience": "function"
          }
        },
        "rules": {
          "maxPerModule": 1
        }
      },
